# نموذج: انسخه باسم keystore.properties في مجلد المشروع الرئيسي، وضع بجانبه مجلد signing فيه ملف المفتاح.
# المفتاح وكلمة مروره يُرسلان منفصلين عن المشروع ولا يوضعان معه في أي ملف مضغوط أو مستودع.
# بدون المفتاح نفسه لا يُثبَّت أي تحديث فوق 8.0 مع بقاء بياناته، ولا تعمل الرخص (بصمة الشهادة مضمّنة).
storeFile=signing/smart-accountant-v8.jks
storePassword=ضع_كلمة_المرور_هنا
keyAlias=smart_accountant_v8
keyPassword=ضع_كلمة_المرور_هنا
