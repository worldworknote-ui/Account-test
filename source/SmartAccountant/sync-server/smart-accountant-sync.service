[Unit]
Description=Smart Accountant private sync server
After=network.target

[Service]
Environment=PORT=8090
Environment=DATA_DIR=/var/lib/smart-accountant-sync
# 10.11: الخادم يرفض البدء ما دامت هذه القيمة النموذجية. ضع سرًا عشوائيًا (مثل: openssl rand -hex 32)
Environment=SERVER_KEY=change-me-to-a-long-random-secret
# خلف Caddy/nginx على الجهاز نفسه:
#Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node /opt/smart-accountant-sync/server.js
Restart=always
User=nobody
Group=nogroup
StateDirectory=smart-accountant-sync
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smart-accountant-sync

[Install]
WantedBy=multi-user.target
