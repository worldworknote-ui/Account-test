<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- الوضع الفاتح (الافتراضي). الخط الافتراضي IBM Plex Sans Arabic؛ يمكن تغييره من «تخصيص الشكل». -->
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F7F4ED</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorAccent">#0B6B53</item>
        <item name="android:colorPrimary">#0B6B53</item>
        <item name="android:colorPrimaryDark">#08513F</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/plex</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase"/>

    <!-- الوضع الليلي -->
    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#0F1A17</item>
        <item name="android:navigationBarColor">#172521</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorAccent">#5CCBA3</item>
        <item name="android:colorPrimary">#0E7A5E</item>
        <item name="android:colorPrimaryDark">#0F1A17</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/plex</item>
    </style>
    <style name="AppThemeDark" parent="AppThemeDarkBase"/>

    <!-- طبقات الخط: تُطبَّق فوق السمة عند التشغيل حسب اختيار المستخدم -->
    <style name="FontPlex"><item name="android:fontFamily">@font/plex</item></style>
    <style name="FontCairo"><item name="android:fontFamily">@font/cairo</item></style>
    <style name="FontKufi"><item name="android:fontFamily">@font/kufi</item></style>
    <style name="FontSystem"><item name="android:fontFamily">sans-serif</item></style>
</resources>
