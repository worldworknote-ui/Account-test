<?xml version="1.0" encoding="utf-8"?>
<!-- اختصارات أيقونة التطبيق (ضغطة مطولة على الأيقونة). رقم الحزمة يجب أن يطابق applicationId. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="new_tx" android:enabled="true" android:icon="@drawable/sc_new_tx"
        android:shortcutShortLabel="@string/sc_new_tx" android:shortcutLongLabel="@string/sc_new_tx_long">
        <intent android:action="com.smart.hawala.action.NEW_TX" android:targetPackage="com.smart.hawala.v8" android:targetClass="com.smart.hawala.MainActivity"/>
    </shortcut>
    <shortcut android:shortcutId="paste" android:enabled="true" android:icon="@drawable/sc_paste"
        android:shortcutShortLabel="@string/sc_paste" android:shortcutLongLabel="@string/sc_paste_long">
        <intent android:action="com.smart.hawala.action.PASTE" android:targetPackage="com.smart.hawala.v8" android:targetClass="com.smart.hawala.MainActivity"/>
    </shortcut>
    <shortcut android:shortcutId="offices" android:enabled="true" android:icon="@drawable/sc_offices"
        android:shortcutShortLabel="@string/sc_offices" android:shortcutLongLabel="@string/sc_offices">
        <intent android:action="com.smart.hawala.action.OFFICES" android:targetPackage="com.smart.hawala.v8" android:targetClass="com.smart.hawala.MainActivity"/>
    </shortcut>
    <shortcut android:shortcutId="search" android:enabled="true" android:icon="@drawable/sc_search"
        android:shortcutShortLabel="@string/sc_search" android:shortcutLongLabel="@string/sc_search_long">
        <intent android:action="com.smart.hawala.action.SEARCH" android:targetPackage="com.smart.hawala.v8" android:targetClass="com.smart.hawala.MainActivity"/>
    </shortcut>
