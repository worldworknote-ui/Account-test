<?xml version="1.0" encoding="utf-8"?>
<!-- بيانات التطبيق مشفّرة بمفتاح الجهاز؛ لذلك لا تُنقل ولا تُحفظ في سحابة النسخ الاحتياطي.
     استخدم «نسخة احتياطية مشفرة» من داخل التطبيق. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
